# ==============================================================================
# Geospatial Labs - Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# In production (e.g. Vercel, Netlify, Cloudflare Pages), add these environment
# variables via your hosting platform's dashboard.
#
# IMPORTANT SECURITY RULES:
# - ONLY use client-safe public keys (Supabase Anon / Publishable key, Mapbox Public Token).
# - NEVER put a Supabase service_role key, database password, or Mapbox secret token in this file or frontend code!
# - Ensure Row Level Security (RLS) is enabled on public.site_screen_requests table.
# - In the Mapbox account dashboard, add URL/domain restrictions to your public token.
# ==============================================================================

# Supabase Project URL (from Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Supabase Anon / Publishable API Key (safe for browser use with RLS enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key-here

# Vite compatibility aliases for Supabase
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key-here

# Mapbox Public Token (from Mapbox Dashboard > Tokens > Default public token)
# Must begin with 'pk.' and be domain-restricted to your production & preview domains.
NEXT_PUBLIC_MAPBOX_PUBLIC_TOKEN=pk.your-public-mapbox-token-here

# Vite compatibility alias for Mapbox
VITE_MAPBOX_PUBLIC_TOKEN=pk.your-public-mapbox-token-here
